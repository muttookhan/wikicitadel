  {
   "@id": "https://wikicitadel.example.org/citation/c0001",
   "@type": [
    "wk:Citation"
   ],
   "cito:cites": {
    "@id": "https://wikicitadel.example.org/raw/sources/founding-note.md"
   },
   "wk:citesSource": {
    "@id": "https://wikicitadel.example.org/raw/sources/founding-note.md"
   },
   "wk:claimHash": "4059f6476331ee1b7edc5c1011e26ade8bf34842ffb73542cb220ebc318ae56b",
   "wk:claimText": "The owner is the human who owns this installation: the corpus, the decisions, and the final word on both.",
   "wk:contentHash": "cb6d807b466ee6c5c44db08f52d9c997a943c15b48b0859fd510980b1c46be23",
   "wk:hasSelector": {
    "@id": "https://wikicitadel.example.org/citation/c0001/selector"
   },
   "wk:lineHash": [
    "4a7ec0cee94ff0735e0a2aaa0417f4dc4a20dfc79e0411b96ac899722430aae3",
    "6f964512d0630a3aa74ba646b1ffa40e4ab0fd5ca9b843b7a06aec5984b9b405",
    "d54015565d0d61cf1a5412496ea344f92792a29f7c66e31d53037bd251480ece",
    "e5fa6dd1d3bdf563accec9f92bfe3d6b9195bce95cce9e107869e1078502d25d"
   ],
   "wk:lineRangeEnd": 16,
   "wk:lineRangeStart": 13,
   "wk:onPage": {
    "@id": "https://wikicitadel.example.org/wiki/entities/owner.md"
   },
   "wk:pageLine": 21
  },
  {
   "@id": "https://wikicitadel.example.org/citation/c0001/selector",
   "@type": [
    "oa:TextQuoteSelector"
   ],
   "oa:exact": "One correction, the same day, and it overrides the sentence above wherever\nthe two conflict: that direction covers work, never decisions. Every\ndecision — what to adopt, what to publish, what to spend, what to delete —\nneeds my own approval, asked for one at a time.",
   "oa:prefix": "— without asking me\neach time.\n\n"
  },
  {
   "@id": "https://wikicitadel.example.org/citation/c0002",
   "@type": [
    "wk:Citation"
   ],
   "cito:cites": {
    "@id": "https://wikicitadel.example.org/raw/sources/founding-note.md"
   },
   "wk:citesSource": {
    "@id": "https://wikicitadel.example.org/raw/sources/founding-note.md"
   },
   "wk:claimHash": "ca248b66d2bc17fe3398826c86a75ab2da03ce7a5784afc0640e37928a901d14",
   "wk:claimText": "Dieses Wiki existiert, weil der Eigentümer sich entschied, den Kontext des Agenten sichtbar zu halten, in versionierten Dateien, die jede Person prüfen kann, statt im eigenen Gedächtnis des Agenten.",
   "wk:contentHash": "3f0de5c9edd17ccc4b61d1dbc9d0c500d6dfc4a96e071d6817ba0526e262d513",
   "wk:hasSelector": {
    "@id": "https://wikicitadel.example.org/citation/c0002/selector"
   },
   "wk:lineHash": [
    "4408bc4b4a3c151e005b92f005ff0343a3e6885298540109cd22ccba0229ce83",
    "82e0002876a0a8459cd229282a9542c48cc9fe292981d2d00cb3cd3be33a5a3a",
    "852ad901f1b4ef04472da04b7842a9f2b653f3cf4eade833251ee896a9797464",
    "cdbb7ddad51f1e9c365765ca78e0437a992f9786aa8b9dddcf2d03c7cf44f533",
    "dd8e8f0ee2d21bb5533bd056df130116428d29ea2738abea97f8aabe6169f065"
   ],
   "wk:lineRangeEnd": 7,
   "wk:lineRangeStart": 3,
   "wk:onPage": {
    "@id": "https://wikicitadel.example.org/wiki/i18n/de/overview.md"
   },
   "wk:pageLine": 24
  },
  {
   "@id": "https://wikicitadel.example.org/citation/c0002/selector",
   "@type": [
    "oa:TextQuoteSelector"
   ],
   "oa:exact": "I am setting up this wiki because I do not want the agent's working memory\nto live inside the agent, where I cannot see it, check it, or hand it to\nanother agent. Everything the agent knows about my work should live here,\nin plain files under version control, with the source of every claim\nattached to the claim.",
   "oa:prefix": "tated by the owner, 2026-01-15\n\n",
   "oa:suffix": "\n\nTo keep things moving I am giv"
  },
  {
   "@id": "https://wikicitadel.example.org/citation/c0003",
   "@type": [
    "wk:Citation"
   ],
   "cito:cites": {
    "@id": "https://wikicitadel.example.org/raw/sources/founding-note.md"
   },
   "wk:citesSource": {
    "@id": "https://wikicitadel.example.org/raw/sources/founding-note.md"
   },
   "wk:claimHash": "975aa4d27b9aaecb38c2cb8d47f7edfa7c017f2bd5e9b3d392a882a87067e1a9",
   "wk:claimText": "**D1 ― 一括指示（置き換えられた形式）。** 所有者は、エージェントが毎回尋ねることなく作業――読むこと、ファイリングすること、構築すること――を進めてよいと指示した。 この形式の決定は同日のうちにD2によって置き換えられた。ここに残され、処遇レジスタにも否定的な処遇とともに残されているのは、静かに書き換えられたレジスタが後のすべての読者に偽りの歴史を教えてしまうためである。",
   "wk:contentHash": "ca62113a89653cdde347adfdbf166c6d7382827644e83ebb01112cb55ae2a99b",
   "wk:hasSelector": {
    "@id": "https://wikicitadel.example.org/citation/c0003/selector"
   },
   "wk:lineHash": [
    "041b1274423a01ef0d92d47c00478c7365237a767b711a0e6ae1e786c97a55cb",
    "69d9298917ab0b8e536e8054620d0536cacb792042a6690ed963d4053a4e2a23",
    "aa7f6cce2dd058b0fdd7ad652264333171f83172c6e67137b429ca2be921e854",
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
   ],
   "wk:lineRangeEnd": 12,
   "wk:lineRangeStart": 9,
   "wk:onPage": {
    "@id": "https://wikicitadel.example.org/wiki/i18n/ja/decision-register.md"
   },
   "wk:pageLine": 26
  },
  {
   "@id": "https://wikicitadel.example.org/citation/c0003/selector",
   "@type": [
    "oa:TextQuoteSelector"
   ],
   "oa:exact": "To keep things moving I am giving a blanket direction: the agent may\nproceed with the work — reading, filing, building — without asking me\neach time.\n",
   "oa:prefix": "y claim\nattached to the claim.\n\n",
   "oa:suffix": "\nOne correction, the same day, a"
  },
  {
   "@id": "https://wikicitadel.example.org/citation/c0004",
   "@type": [
    "wk:Citation"
   ],
   "cito:cites": {
    "@id": "https://wikicitadel.example.org/raw/sources/founding-note.md"
   },
   "wk:citesSource": {
    "@id": "https://wikicitadel.example.org/raw/sources/founding-note.md"
   },
   "wk:claimHash": "1891c1ead6f979c00e5e1a871bcfe899f90df26d4acdc5c6d31e5fbd2eb16601",
   "wk:claimText": "**D2 ― 決定は決して対象に含まれない（現行）。** 所有者は同日のうちに一括指示を覆した。決定はその対象に含まれず、すべての決定には所有者自身の承認が必要である。",
   "wk:contentHash": "cb6d807b466ee6c5c44db08f52d9c997a943c15b48b0859fd510980b1c46be23",
   "wk:hasSelector": {
    "@id": "https://wikicitadel.example.org/citation/c0004/selector"
   },
